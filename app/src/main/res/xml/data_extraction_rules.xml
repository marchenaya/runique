<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="auth_keyset_prefs.xml" />
        <exclude
            domain="file"
            path="datastore/auth_info.json" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="auth_keyset_prefs.xml" />
        <exclude
            domain="file"
            path="datastore/auth_info.json" />
    </device-transfer>
</data-extraction-rules>